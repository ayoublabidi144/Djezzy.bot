def request_otp(phone):
    params = {
        "msisdn": phone,
        "client_id": APP_CLIENT_ID,
        "scope": "smsotp",
    }
    consent = {
        "consent-agreement": [{"marketing-notifications": False}],
        "is-consent": True,
    }
    headers = {
        "User-Agent": "MobileApp/3.0.0",
        "Accept": "application/json",
        "Content-Type": "application/json",
        "accept-language": "fr",
    }
    try:
        response = requests.post(
            BASE + "/oauth2/registration",
            params=params,
            json=consent,
            headers=headers,
            timeout=TIMEOUT,
        )
    except requests.RequestException as exc:
        raise RuntimeError(f"خطأ في الشبكة: {exc}") from exc

    # طباعة واسترجاع سبب الرفض الحقيقي من جازي
    if response.status_code not in (200, 201, 202):
        detail = response.text[:400]
        raise RuntimeError(f"رفض جازي (HTTP {response.status_code}): {detail}")
    return None
