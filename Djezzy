    url = root + path
    r = requests.request(
        method, url, headers=json_headers(user["access_token"]),
        timeout=TIMEOUT, **kwargs
    )
    if r.status_code == 401 and refresh_session(user):
        r = requests.request(
            method, url, headers=json_headers(user["access_token"]),
