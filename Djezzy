def normalize_phone(value):
    digits = re.sub(r"\D", "", str(value))
    if digits.startswith("0") and len(digits) == 10:
        digits = "213" + digits[1:]
    elif len(digits) == 9 and digits[0] in "567":
        digits = "213" + digits
    if not re.fullmatch(r"213[567]\d{8}", digits):
        raise ValueError("أدخل رقم جازي صحيحاً، مثال: 0770123456")
    return digits


def form_headers(token=None):
    h = {
        "User-Agent": UA,
        "Accept": "*/*",
        "Content-Type": "application/x-www-form-urlencoded",
    }
    if token:
        h["Authorization"] = f"Bearer {token}"
    return h


def json_headers(token):
    return {
        "User-Agent": UA,
        "Accept": "application/json",
        "Content-Type": "application/json",
        "Accept-Language": "ar",
        "Authorization": f"Bearer {token}",
    }


def request_otp(phone):
    params = {"msisdn": phone, "client_id": APP_CLIENT_ID, "scope": "smsotp"}
    consent = {"consent-agreement": [{"marketing-notifications": False}], "is-consent": True}
    headers = {"User-Agent": "MobileApp/3.0.0", "Accept": "application/json", "Content-Type": "application/json", "accept-language": "fr"}
    try:
        response = requests.post(BASE + "/oauth2/registration", params=params, json=consent, headers=headers, timeout=TIMEOUT)
    except requests.RequestException as exc:
        raise RuntimeError(f"خطأ في الشبكة: {exc}") from exc

    if response.status_code not in (200, 201, 202):
        detail = response.text[:400]
        raise RuntimeError(f"رفض جازي (HTTP {response.status_code}): {detail}")
    return None


def verify_otp(phone, otp, token=None):
    r = requests.post(
        BASE + "/oauth2/token",
        headers=form_headers(),
        data={
            "grant_type": "mobile", "mobileNumber": phone, "otp": otp,
            "client_id": APP_CLIENT_ID, "client_secret": APP_CLIENT_SECRET, "scope": "djezzyAppV2",
        },
        timeout=TIMEOUT,
    )
    r.raise_for_status()
    return r.json()


def refresh_session(user):
    if not user.get("refresh_token"):
        return False
    r = requests.post(
        BASE + "/oauth2/token",
        headers=form_headers(),
        data={
            "grant_type": "refresh_token", "refresh_token": user["refresh_token"],
            "client_id": APP_CLIENT_ID, "client_secret": APP_CLIENT_SECRET, "scope": "djezzyAppV2",
        },
        timeout=TIMEOUT,
    )
    if r.status_code != 200:
        return False
    data = r.json()
    user["access_token"] = data["access_token"]
    user["refresh_token"] = data.get("refresh_token", user["refresh_token"])
    return True


def api_request(user, method, path, *, content=False, **kwargs):
    root = CONTENT_API if content else API
    url = root + path
    r = requests.request(method, url, headers=json_headers(user["access_token"]), timeout=TIMEOUT, **kwargs)
    if r.status_code == 401 and refresh_session(user):
        r = requests.request(method, url, headers=json_headers(user["access_token"]), timeout=TIMEOUT, **kwargs)
    if r.status_code == 402 and "/services/shake/" in path:
        try:
            return r.json()
        except ValueError:
            return {"status": 402, "message": "تم قبول طلب التفعيل."}
    r.raise_for_status()
    if not r.text.strip():
        return {}
    try:
        return r.json()
    except ValueError:
        return {"raw": r.text[:1000]}


