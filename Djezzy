async def handle_text(update, context):
    if not await guard(update):
        return
    text = (update.message.text or "").strip()
    uid = update.effective_user.id
    state = context.user_data.get("state")

    # التعامل مع الضغط على الأزرار الثابتة
    if text == "🔐 تسجيل الدخول":
        return await login(update, context)
    elif text == "🚪 تسجيل الخروج":
        return await logout(update, context)
    elif text == "💰 الرصيد":
        return await balance(update, context)
    elif text == "📦 الباقات النشطة":
        return await packages(update, context)
    elif text == "🧾 سجل الاشتراكات":
        return await history(update, context)
    elif text == "🎁 الكتالوج":
        return await catalog(update, context)
    elif text == "🎲 هز واربح":
        return await shake(update, context)
    elif text == "🚶 امشي واربح":
        return await walk(update, context)
    elif text == "📨 إرسال دعوة":
        return await invite(update, context)
    elif text == "📋 سجل الدعوات":
        return await invitations(update, context)
    elif text == "🧩 الخدمات الرقمية":
        return await services(update, context)

    if state == "phone":
        try:
            phone = normalize_phone(text)
            token = request_otp(phone)
            context.user_data.update({"login_phone": phone, "public_token": token, "state": "otp"})
            await update.message.reply_text("📩 طلبت رمز التحقق لرقمك. أرسل رمز OTP هنا:")
        except Exception as exc:
            await send_error(update.message, exc)
        return

    if state == "otp":
        if not re.fullmatch(r"\d{4,8}", text):
            await update.message.reply_text("رمز OTP يجب أن يتكون من أرقام فقط.")
            return
        try:
            phone = context.user_data["login_phone"]
            tokens = verify_otp(phone, text, context.user_data.get("public_token"))
            sessions[uid] = {
                "phone": phone,
                "access_token": tokens["access_token"],
                "refresh_token": tokens.get("refresh_token"),
            }
            context.user_data.clear()
            await update.message.reply_text("✅ تم تسجيل الدخول بنجاح!", reply_markup=get_main_keyboard())
        except Exception as exc:
            context.user_data.clear()
            await send_error(update.message, exc)
        return

    await update.message.reply_text("استخدم الأزرار أدناه أو اكتب /start", reply_markup=get_main_keyboard())


